{
  "name": "linkedin-ads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test && node --test services/creative-worker/test/*.test.mjs",
    "cli": "pnpm --filter @liads/cli start",
    "mcp": "pnpm --filter @liads/mcp start",
    "gen:tools": "pnpm --filter \"@liads/mcp...\" build && node packages/mcp/scripts/gen-tools.mjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
