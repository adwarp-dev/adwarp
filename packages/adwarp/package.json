{
  "name": "adwarp",
  "version": "0.2.0",
  "description": "Open-source ad agent for LinkedIn Ads and Google Ads. Drafts campaigns, audiences and reports from Claude or any MCP client.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "linkedin-ads",
    "google-ads",
    "ai-agent",
    "claude",
    "cli"
  ],
  "homepage": "https://adwarp.dev",
  "bugs": "https://github.com/adwarp-dev/adwarp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adwarp-dev/adwarp.git",
    "directory": "packages/adwarp"
  },
  "license": "MIT",
  "mcpName": "io.github.adwarp-dev/adwarp",
  "type": "module",
  "bin": {
