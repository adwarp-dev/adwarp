    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@adwarp/cli": "workspace:*",
    "@adwarp/mcp": "workspace:*",
    "@adwarp/shared": "workspace:*",
    "esbuild": "^0.28.1"
