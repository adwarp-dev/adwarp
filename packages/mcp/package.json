{
  "name": "@liads/mcp",
  "version": "0.1.0",
  "description": "Adwarp MCP server, the open-source ad agent for LinkedIn Ads and Google Ads",
  "private": true,
  "type": "module",
  "bin": {
    "adwarp-mcp": "./dist/index.js",
    "liads-mcp": "./dist/index.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@liads/core": "workspace:*",
    "@liads/google": "workspace:*",
    "@liads/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.1"
  }
}
